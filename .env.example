# Template for the Docker / production deployment (docker compose, see
# docs/runbook.md). Running the portal on one machine without Docker? Use
# .env.local-dev.example instead: `npm run setup` copies it to .env for you.

# ---------------------------------------------------------------- database --
POSTGRES_USER=aktivacity
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=aktivacity
DATABASE_URL=postgres://aktivacity:change-me-in-production@postgres:5432/aktivacity
DATABASE_POOL_MAX=10

# ------------------------------------------------------------------- server --
# Hostname staff use on the internal network. Must resolve on the LAN (DNS
# entry or hosts file) and match the certificate Caddy issues.
PORTAL_HOSTNAME=portal.aktivacity.local
NODE_ENV=production
# Secure flag on the session cookie: true, false, or blank = automatic
# (Secure exactly when the browser came over HTTPS). The app service in
# docker-compose.yml pins it to true, since only Caddy's HTTPS reaches it, so
# this line matters only when the portal runs outside Compose.
SESSION_COOKIE_SECURE=

# ------------------------------------------------------------------- storage --
# Uploaded project files. Must live OUTSIDE the web root and on a volume with
# room to grow — this is a video agency (see docs/phase-1a-plan.md, M2).
STORAGE_ROOT=/var/lib/aktivacity/storage

# --------------------------------------------------------- first administrator --
# Used once by `npm run db:seed`. Change the password at first login.
ADMIN_EMAIL=admin@aktivacity.local
ADMIN_PASSWORD=change-this-immediately
ADMIN_NAME=Administrator

# ------------------------------------------------------------------- backups --
# See docs/runbook.md, "Backup". The `backup` service dumps the database into
# ./backups/db and copies the file store and the dumps off the box with restic.
#
# Off-box target. Either a host path where the NAS / second disk is mounted
# (set BACKUP_REPO_HOST_DIR to it and RESTIC_REPOSITORY=/repo), or a remote
# URL such as sftp:backup@nas.aktivacity.local:/aktivacity or
# rest:https://nas.aktivacity.local:8000/aktivacity.
#
# File backups are mandatory (brief §44). With RESTIC_REPOSITORY empty the
# database is still dumped, but every backup run FAILS and the dashboard says
# "File backups are not configured": the uploaded files are not backed up
# anywhere. The only way to run without them is the explicit opt-out below
# (database dumps only; the dashboard then says file backups are switched
# off). With neither set, every nightly run fails until one of them is.
#BACKUP_REPO_HOST_DIR=/mnt/nas/aktivacity-restic
#RESTIC_REPOSITORY=/repo
#BACKUP_FILES_DISABLED=1
#
# Without BACKUP_REPO_HOST_DIR, docker-compose.yml mounts
# ./backups/restic-NOT-OFFSITE as /repo. That directory is on this server's
# own disk and is not a backup: a repository there is reported "degraded",
# and the backup job never creates one there itself.
#
# Or cloud storage (brief §29; needs internet for the backup only), e.g.
#   RESTIC_REPOSITORY=s3:s3.eu-central-1.amazonaws.com/aktivacity-backups
#   AWS_ACCESS_KEY_ID=…  AWS_SECRET_ACCESS_KEY=…  AWS_DEFAULT_REGION=eu-central-1
# or RESTIC_REPOSITORY=b2:aktivacity-backups:portal with B2_ACCOUNT_ID / B2_ACCOUNT_KEY.
#
# Encrypts the repository. Store a copy OFF this server (password manager):
# without it the off-box copy cannot be read, and a dead server takes .env
# with it.
#RESTIC_PASSWORD=change-me-long-random-and-kept-off-this-server
#
# Cron schedules (minute hour day month weekday), in BACKUP_TZ.
#BACKUP_TZ=UTC
#BACKUP_SCHEDULE="30 2 * * *"
#VERIFY_SCHEDULE="30 4 * * 0"
#
# Local dumps: delete after this many days, but always keep the newest N.
#BACKUP_KEEP_DAYS=14
#BACKUP_KEEP_MIN=7
#
# restic retention (`restic forget --prune`).
#RESTIC_KEEP_DAILY=7
#RESTIC_KEEP_WEEKLY=4
#RESTIC_KEEP_MONTHLY=12
#
# Share of the repository's data the weekly rehearsal reads back and checks.
#RESTIC_CHECK_SUBSET=2%
#
# Soft-deleted files are purged by the sweep after this many days.
#FILE_RETENTION_DAYS=30
#
# The scheduler service runs the retention sweep, the recurring projects and
# the nightly housekeeping on these schedules (minute hour day month weekday,
# in BACKUP_TZ), all before the backup. See docs/runbook.md, "Scheduled jobs".
#SWEEP_SCHEDULE="0 2 * * *"
#RECURRING_SCHEDULE="15 2 * * *"
#NIGHTLY_SCHEDULE="20 2 * * *"

# --- Optional outbound notifications (brief §29, §46) ------------------------
# Leave blank and the portal's inbox is the only channel. Set any of these and
# start the dispatcher:  docker compose --profile integrations up -d notifier
PORTAL_BASE_URL=
# Email through the office mail server, e.g. smtp://user:pass@mail.aktivacity.local:587
SMTP_URL=
MAIL_FROM="Aktivacity Portal <portal@aktivacity.com>"
# Slack: a bot token with chat:write (needs internet access)
SLACK_BOT_TOKEN=
# WhatsApp Business Cloud API (needs internet access). The template must be
# approved by Meta and take two body parameters: the title and a link.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en

# WhatsApp Free Executive Alerts (CEO & COO)
# Direct recipient numbers (E.164 with country code, e.g. +923001234567)
WHATSAPP_CEO_PHONE=+923312355223S
WHATSAPP_COO_PHONE=
# Optional additional management numbers (comma separated)
WHATSAPP_MANAGEMENT_PHONES=
# Free self-hosted gateway URL (e.g. Baileys / Evolution API running on localhost:3001)
WHATSAPP_GATEWAY_URL=http://localhost:3001/send
WHATSAPP_GATEWAY_API_KEY=

# --- Optional AI project summaries (brief §29, §46) --------------------------
# Unset = off. When set, "Summarise with AI" on a project sends that project's
# details to Anthropic over the internet. Deadline forecasts and assignment
# suggestions never need this: they are computed on the server.
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5
