# Local development / single-machine demo — no Docker, no cloud.
#
# `npm run setup` copies this file to .env when .env does not exist yet.
# Both the portal (next dev / next start) and the command-line scripts
# (npm run db:migrate, db:seed:demo, ...) read .env. A variable already set in
# your shell always wins over the value here.
#
# For the Docker / production deployment use .env.example instead.
#
# Keep comments on their own lines: this file is read by both Next.js and
# Node's --env-file, and only whole-line comments mean the same to both.

# ---------------------------------------------------------------- database --
# The project-local PostgreSQL started by `npm run db:local -- start`
# (macOS/Linux; data in ./.data/postgres, port 5433, localhost only).
# Using a PostgreSQL you installed yourself (Windows, Postgres.app, apt, ...)?
# Point this at it instead, e.g.
#   postgres://postgres:YOUR_PASSWORD@localhost:5432/aktivacity
# `npm run setup` creates the database if the server is up but it is missing.
DATABASE_URL=postgres://aktivacity:aktivacity@localhost:5433/aktivacity

# ------------------------------------------------------------------ storage --
# Uploaded and seeded project files. Relative paths resolve against the
# project folder (where you run npm). ./storage is git-ignored.
# `npm run setup` makes this folder readable by your account only (mode 700):
# the portal is meant to be the only way to a file (brief §43). On a machine
# other people can log in to, or whose project folder is shared, put it
# outside the checkout instead, e.g. /var/lib/aktivacity/storage, and never
# share it over SMB or AFP (docs/runbook.md, "The file store without Docker").
STORAGE_ROOT=./storage

# ------------------------------------------------------------------ sign-in --
# Secure flag on the session cookie: true, false, or blank = automatic.
# Automatic sets it exactly when the browser came over HTTPS, so colleagues
# can sign in at http://<this-machine's-ip>:3000 on the office network (a
# browser drops a Secure cookie sent over plain HTTP). Set true only when
# every visitor comes through an HTTPS proxy.
SESSION_COOKIE_SECURE=

# ------------------------------------------------------------------ backups --
# `npm run backup` dumps the database into BACKUP_DIR/db and, with restic,
# copies the dumps and the file store off this machine; `npm run
# backup:verify` restores the newest dump into a scratch database and checks
# it against the live one (brief §44-45). Each run writes its result to
# BACKUP_STATUS_DIR, which the management dashboard and /api/health read.
# Relative paths resolve against the project folder; ./backups is git-ignored.
BACKUP_DIR=./backups
BACKUP_STATUS_DIR=./backups/status
#
# Off-box copy with restic (brew install restic, or restic.net): a second
# disk or a NAS mount, never this machine's own disk. Keep RESTIC_PASSWORD
# somewhere other than this machine too.
# File backups are mandatory (brief §44). Without RESTIC_REPOSITORY each
# `npm run backup` still makes and checks its dump but FAILS and records it,
# so the dashboard reads "File backups are not configured"; `npm start`
# refuses to start and `npm run dev` warns. The explicit opt-out is
# BACKUP_FILES_DISABLED=1: database dumps only, on purpose (the dashboard
# then says file backups are switched off). A dump on this machine's own
# disk is not a backup either way.
#RESTIC_REPOSITORY=/Volumes/BackupDisk/aktivacity-restic
#RESTIC_PASSWORD=change-me-long-random-and-kept-off-this-machine
#BACKUP_FILES_DISABLED=1
#
# Backups are automatic only once scheduled. macOS/Linux, with `crontab -e`
# (cron's PATH is minimal, so name the folder node and npm live in):
#   PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin
#   30 2 * * * cd /path/to/portal && mkdir -p backups && npm run backup >> backups/backup.log 2>&1
#   30 4 * * 0 cd /path/to/portal && npm run backup:verify >> backups/verify.log 2>&1
# macOS keeps cron out of Desktop, Documents and Downloads: a portal folder
# there fails with "Operation not permitted" before anything is logged or
# recorded. Keep the portal elsewhere (e.g. ~/aktivacity-portal), or give
# /usr/sbin/cron Full Disk Access (System Settings > Privacy & Security).
# Windows: a daily Task Scheduler task running Git for Windows' bash, which
# the scripts need:
#   Program:   C:\Program Files\Git\bin\bash.exe
#   Arguments: -lc "cd /c/path/to/portal && npm run backup >> backups/backup.log 2>&1"
# and a weekly one the same way with `npm run backup:verify`.
# The nightly jobs (npm run files:sweep, projects:recurring, jobs:nightly)
# are scheduled the same way; each records its run under STORAGE_ROOT/jobs,
# which the dashboard and /api/health read (docs/runbook.md, "Scheduled
# jobs").
#
# Local dumps: delete after this many days, but always keep the newest N.
#BACKUP_KEEP_DAYS=14
#BACKUP_KEEP_MIN=7
#
# pg_dump and friends are taken from PATH, else from the usual Homebrew,
# Postgres.app and apt locations (newest first). Elsewhere, point PG_BIN at
# the bin directory. It must be at least as new as the server.
#PG_BIN=/opt/homebrew/opt/postgresql@17/bin

# ------------------------------------------------------------------ privacy --
# No anonymous usage data to Vercel from next build / dev / start.
NEXT_TELEMETRY_DISABLED=1

# ---------------------------------------------------- optional integrations --
# Everything below is OFF while blank, and a blank value keeps the portal
# fully offline: notifications stay in the portal's own inbox and nothing is
# sent anywhere.
#
# Email copies of notifications through a mail server you run, e.g.
#   smtp://user:pass@mail.example.local:587   (also needs MAIL_FROM)
SMTP_URL=
MAIL_FROM=
# Slack direct messages. Needs internet access.
SLACK_BOT_TOKEN=
# WhatsApp Business Cloud API. Needs internet access.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
# Links inside email/Slack/WhatsApp messages, e.g. http://localhost:3000
PORTAL_BASE_URL=
# "Summarise with AI" on a project. Sends that project's details to
# Anthropic over the internet when someone clicks it. Blank = the button is
# hidden and nothing leaves this machine.
ANTHROPIC_API_KEY=

# ---------------------------------------------------- first administrator --
# Only for `npm run db:seed`, which creates a single administrator in an
# otherwise EMPTY portal (instead of the demo data). Password: 12+ characters.
#ADMIN_EMAIL=admin@aktivacity.local
#ADMIN_PASSWORD=change-this-immediately
#ADMIN_NAME=Administrator
